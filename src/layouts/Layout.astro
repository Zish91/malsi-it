---
const { title = "MALSI IT — Maintenance, Audit, Logiciels, Sécurité, Infrastructure" } = Astro.props;
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="MALSI IT — Votre partenaire en sécurité réseau, administration systèmes et infrastructure IT pour PME et collectivités." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
</head>
<body>
  <slot />
</body>
</html>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

  :root {
    --navy: #0f172a;
    --slate: #334155;
    --text-light: #64748b;
    --border: #e2e8f0;
    --bg-white: #ffffff;
    --bg-alt: #f8fafc;
    --accent: #2563eb;
    --accent-hover: #1d4ed8;
    --green: #059669;
    --green-light: #d1fae5;
    --font: 'Inter', system-ui, sans-serif;
    --section-padding: 5rem 1.5rem;
    --container: 1100px;
    --radius: 12px;
  }

  *, *::before, *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: var(--font);
    color: var(--slate);
    background: var(--bg-white);
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }

  a { text-decoration: none; color: inherit; }
  ul { list-style: none; }
  img { max-width: 100%; display: block; }

  .container {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section { padding: var(--section-padding); }
  .section-alt { padding: var(--section-padding); background: var(--bg-alt); }

  .section-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--navy);
    margin-bottom: 0.5rem;
  }

  .section-subtitle {
    font-size: 1.1rem;
    color: var(--text-light);
    margin-bottom: 3rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.75rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    font-family: var(--font);
    cursor: pointer;
    border: none;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background: var(--accent);
    color: #fff;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
  }

  .btn-outline {
    background: transparent;
    color: var(--accent);
    border: 2px solid var(--accent);
  }

  .btn-outline:hover {
    background: var(--accent);
    color: #fff;
  }

  @media (max-width: 768px) {
    .section-title { font-size: 1.6rem; }
    :root { --section-padding: 3.5rem 1rem; }
  }
</style>
