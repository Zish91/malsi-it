---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <!-- Cercles décoratifs -->
  <div class="circles">
    <div class="circle circle-1"></div>
    <div class="circle circle-2"></div>
  </div>

  <!-- ============================================
       HERO
       ============================================ -->
  <section class="homepage-title">
    <div class="container">
      <h1 class="home no-dot home-hero__title">
        Votre partenaire en<br />
        <span class="magic-text">
          <span class="current">sécurité informatique.</span>
          <span>infrastructure réseau.</span>
          <span>administration système.</span>
          <span>maintenance IT.</span>
        </span>
      </h1>

      <div class="home-hero__text">
        <p>Nous sécurisons et administrons l'informatique des PME et collectivités. Audit, maintenance, infrastructure — tout est couvert.</p>
        <a href="#contact" class="btn-primary">Demander un audit gratuit</a>
      </div>
    </div>

    <div class="scroll-more"></div>
  </section>

  <!-- ============================================
  <!-- ============================================
       STATS
       ============================================ -->
  <section class="home-stats bg-gray">
    <div class="home-stats__inner container">
      <div class="home-stats__texts">
        <h2 data-sal="fade-up">Ces chiffres font peur.<br/>Les nôtres rassurent.</h2>
        <p class="text--dark">Les entreprises accompagnées par un prestataire IT réduisent leurs incidents de 70%, divisent par 3 leur temps d'arrêt, et dorment tranquilles.</p>
        <p class="text--dark">MALSI IT vous accompagne de l'audit initial à la maintenance quotidienne — pour que ces statistiques ne soient jamais les vôtres.</p>
        <a href="#contact" class="btn-primary" style="margin-top: 2rem;">Protégez votre entreprise</a>
      </div>
      <div class="home-stats__stats">
        <div class="home-stats__item">
          <dotlottie-player src="/lottie/90.json" background="transparent" speed="1" style="width:48px;height:48px;" loop autoplay></dotlottie-player>
          <div class="home-stats__number-row">
            <span class="home-stats__number" data-target="90">0</span>
            <span class="home-stats__suffix">%</span>
          </div>
          <span class="home-stats__number-text">des cyberattaques ciblent les entreprises de -250 salariés</span>
        </div>
        <div class="home-stats__item home-stats__item--positive">
          <dotlottie-player src="/lottie/85.json" background="transparent" speed="1" style="width:48px;height:48px;" loop autoplay></dotlottie-player>
          <div class="home-stats__number-row">
            <span class="home-stats__number" data-target="85">0</span>
            <span class="home-stats__suffix">%</span>
          </div>
          <span class="home-stats__number-text">des incidents évités grâce à une maintenance proactive</span>
        </div>
        <div class="home-stats__item">
          <dotlottie-player src="/lottie/43.json" background="transparent" speed="1" style="width:48px;height:48px;" loop autoplay></dotlottie-player>
          <div class="home-stats__number-row">
            <span class="home-stats__number" data-target="43">0</span>
            <span class="home-stats__suffix">%</span>
          </div>
          <span class="home-stats__number-text">des PME victimes d'une attaque cessent leur activité</span>
        </div>
        <div class="home-stats__item home-stats__item--positive">
          <dotlottie-player src="/lottie/70.json" background="transparent" speed="1" style="width:48px;height:48px;" loop autoplay></dotlottie-player>
          <div class="home-stats__number-row">
            <span class="home-stats__number" data-target="70">0</span>
            <span class="home-stats__suffix">%</span>
          </div>
          <span class="home-stats__number-text">de réduction des pannes avec un prestataire IT régulier</span>
        </div>
      </div>
    </div>
  </section>
       APPROACH — LA ROUE
       ============================================ -->
  <section class="approach" id="services">
    <div class="container">
      <div class="content content-title">
        <h2 data-sal="fade-up" class="title-text home-approach__title">Comment nous protégeons votre entreprise</h2>
      </div>

      <div class="content">
        <!-- Colonne roue -->
        <div class="approach-wrapper">
          <div class="approach-wheel">
            <!-- Couche 1 : fond actif (tourne) — Z-INDEX 1 -->
            <div class="approach-circle-zones approach-circle-active assess">
              <div class="zone active"></div>
              <div class="zone"></div>
              <div class="zone"></div>
              <div class="zone"></div>
            </div>

            <!-- Couche 2 : zones cliquables avec texte — Z-INDEX 2 -->
            <div class="approach-circle-zones approach-circle-front">
              <div class="zone active" data-index="0">
                <div class="zone-in">
                  <div class="home-approach__text">
                    <p>AUDIT &<br/>SÉCURITÉ</p>
                  </div>
                </div>
              </div>
              <div class="zone" data-index="1">
                <div class="zone-in">
                  <div class="home-approach__text">
                    <p>ADMIN<br/>SYSTÈME</p>
                  </div>
                </div>
              </div>
              <div class="zone" data-index="2">
                <div class="zone-in">
                  <div class="home-approach__text">
                    <p>INFRA<br/>RÉSEAU</p>
                  </div>
                </div>
              </div>
              <div class="zone" data-index="3">
                <div class="zone-in">
                  <div class="home-approach__text">
                    <p>MAIN-<br/>TENANCE</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Centre -->
            <div class="approach-circle-center">
              <span class="center-logo">M.</span>
            </div>
          </div>
        </div>

        <!-- Colonne texte -->
        <div class="steps-text">
          <div class="step active" data-step="0">
            <h3>AUDIT & SÉCURITÉ</h3>
            <span class="step-subtitle">Identifiez vos vulnérabilités avant qu'il ne soit trop tard</span>
            <p>Nous réalisons des audits complets de votre infrastructure : tests d'intrusion, analyse des configurations, conformité aux bonnes pratiques. Chaque faille identifiée est une attaque évitée.</p>
            <a href="#contact" class="btn-primary">En savoir plus</a>
          </div>
          <div class="step" data-step="1">
            <h3>ADMINISTRATION SYSTÈME</h3>
            <span class="step-subtitle">Vos serveurs et postes, gérés par des experts</span>
            <p>Active Directory, stratégies de groupe, gestion des droits, déploiement de mises à jour — nous administrons votre parc informatique comme s'il était le nôtre.</p>
            <a href="#contact" class="btn-primary">En savoir plus</a>
          </div>
          <div class="step" data-step="2">
            <h3>INFRASTRUCTURE RÉSEAU</h3>
            <span class="step-subtitle">Un réseau fiable, segmenté et performant</span>
            <p>Conception et déploiement de réseaux sécurisés : VLANs, pare-feu, VPN, Wi-Fi entreprise. Du câblage physique à la configuration des switchs et routeurs.</p>
            <a href="#contact" class="btn-primary">En savoir plus</a>
          </div>
          <div class="step" data-step="3">
            <h3>MAINTENANCE</h3>
            <span class="step-subtitle">Anticipez les pannes, pas les urgences</span>
            <p>Supervision proactive, sauvegardes automatisées, mises à jour régulières, support réactif. Nous gardons votre infrastructure en pleine forme pour que vous puissiez vous concentrer sur votre métier.</p>
            <a href="#contact" class="btn-primary">En savoir plus</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================
       WHY CHOOSE US
       ============================================ -->
  <section class="home-why bg-white" id="apropos">
    <div class="home-why__inner container">
      <h2 data-sal="fade-up" class="home-why__title">Pourquoi choisir MALSI IT ?</h2>
      <ol class="home-why__list">
        <li class="home-why__item" data-sal="fade-up">
          <h3 class="home-why__item-title">Réactivité terrain</h3>
          <p class="home-why__item-text text--dark">Pas de ticket qui traîne. Nous intervenons rapidement, sur site ou à distance, pour résoudre vos problèmes avant qu'ils n'impactent votre activité.</p>
        </li>
        <li class="home-why__item" data-sal="fade-up">
          <h3 class="home-why__item-title">Expertise polyvalente</h3>
          <p class="home-why__item-text text--dark">Réseau, système, sécurité — un seul interlocuteur pour toute votre informatique. Fini les prestataires multiples qui se renvoient la balle.</p>
        </li>
        <li class="home-why__item" data-sal="fade-up">
          <h3 class="home-why__item-title">Adapté aux PME</h3>
          <p class="home-why__item-text text--dark">Des solutions dimensionnées pour votre taille et votre budget. Pas de sur-ingénierie, pas de matériel inutile — juste ce qu'il vous faut.</p>
        </li>
        <li class="home-why__item" data-sal="fade-up">
          <h3 class="home-why__item-title">Transparence totale</h3>
          <p class="home-why__item-text text--dark">Rapports clairs, recommandations expliquées, aucun jargon inutile. Vous comprenez ce qu'on fait et pourquoi on le fait.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ============================================
       BLOG
       ============================================ -->
  <section class="home-blog bg-white">
    <div class="home-blog__inner container">
      <h2 data-sal="fade-up" class="home-blog__title">Derniers articles</h2>
      <div class="blog-grid">
        <a href="#" class="blog-post-item" data-sal="fade-up">
          <div class="blog-post-item__thumbnail-placeholder">
            <span>SÉCURITÉ</span>
          </div>
          <div class="blog-post-item__inner">
            <div class="blog-post-item__meta">
              <span class="blog-post-item__category">Cybersécurité</span>
              <span class="blog-post-item__date">2025</span>
            </div>
            <h3 class="blog-post-item__title">PME : 5 failles que les hackers exploitent en priorité</h3>
            <p class="blog-post-item__description text--dark">Mots de passe faibles, mises à jour ignorées, accès non restreints… Tour d'horizon des vulnérabilités les plus courantes.</p>
          </div>
          <div class="blog-post-item__background"></div>
        </a>

        <a href="#" class="blog-post-item" data-sal="fade-up">
          <div class="blog-post-item__thumbnail-placeholder">
            <span>RÉSEAU</span>
          </div>
          <div class="blog-post-item__inner">
            <div class="blog-post-item__meta">
              <span class="blog-post-item__category">Infrastructure</span>
              <span class="blog-post-item__date">2025</span>
            </div>
            <h3 class="blog-post-item__title">Pourquoi segmenter son réseau est indispensable</h3>
            <p class="blog-post-item__description text--dark">VLANs, pare-feu interne, isolation des postes : les bases d'un réseau qui limite la propagation des menaces.</p>
          </div>
          <div class="blog-post-item__background"></div>
        </a>

        <a href="#" class="blog-post-item" data-sal="fade-up">
          <div class="blog-post-item__thumbnail-placeholder">
            <span>SYSTÈME</span>
          </div>
          <div class="blog-post-item__inner">
            <div class="blog-post-item__meta">
              <span class="blog-post-item__category">Administration</span>
              <span class="blog-post-item__date">2025</span>
            </div>
            <h3 class="blog-post-item__title">Active Directory : les erreurs de config qui coûtent cher</h3>
            <p class="blog-post-item__description text--dark">GPO mal appliquées, comptes orphelins, droits trop larges — les pièges classiques d'un AD mal géré.</p>
          </div>
          <div class="blog-post-item__background"></div>
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================
       CONTACT
       ============================================ -->
  <section class="home-contact bg-white" id="contact">
    <h2 data-sal="fade-up" class="home-contact__title">Sécurisons votre entreprise</h2>
    <p class="home-contact__subtitle text--dark">Vous souhaitez évaluer votre infrastructure, obtenir un accompagnement ou simplement poser une question ? Parlons-en.</p>

    <form class="home-contact__form form-dark" action="https://formsubmit.co/contact@malsi-it.fr" method="POST">
      <input type="hidden" name="_subject" value="Nouveau contact MALSI IT" />
      <input type="hidden" name="_captcha" value="false" />

      <div class="ligne">
        <input type="text" name="name" id="name" required />
        <label for="name">Nom complet</label>
      </div>
      <div class="ligne">
        <input type="email" name="email" id="email" required />
        <label for="email">Email</label>
      </div>
      <div class="ligne">
        <input type="text" name="company" id="company" />
        <label for="company">Entreprise</label>
      </div>
      <div class="ligne ligne-textarea">
        <textarea name="message" id="message" required></textarea>
        <label for="message">Message</label>
      </div>
      <div class="ligne">
        <button type="submit" class="btn-primary">Envoyer</button>
      </div>
    </form>
  </section>

</BaseLayout>

<style>
  /* ============================================
     HERO
     ============================================ */
  .homepage-title {
    min-height: calc(100vh - 80px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    margin: 0;
    padding: 0;
  }

  .home-hero__title.home {
    font-size: 4.8rem;
    font-weight: 700;
    margin-top: 4rem;
  }

  .magic-text {
    display: inline-block;
    position: relative;
    height: 107px;
  }

  .magic-text span {
    position: absolute;
    opacity: 0;
    transform: translateY(-10px);
    transition: all 0.5s ease;
    white-space: nowrap;
    text-transform: uppercase;
  }

  .magic-text span::after {
    content: "";
    color: var(--color-accent);
  }

  .magic-text .current {
    opacity: 1;
    transform: translateY(0);
  }

  .home-hero__text {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 740px;
    margin-top: 1rem;
  }

  .home-hero__text p { margin: 0; }
  .home-hero__text a { margin-top: 2rem; align-self: flex-start; }

  @media (max-width: 1200px) {
    .home-hero__title.home { font-size: 4.4rem; }
    .magic-text { height: auto; }
    .magic-text span { white-space: normal !important; }
  }
  @media (max-width: 900px) {
    .home-hero__title.home { font-size: 3.6rem; margin-top: 2rem; }
  }
  @media (max-width: 600px) {
    .home-hero__title.home { font-size: 2.2rem; }
    .magic-text { height: 80px; }
  }

  /* ============================================
     STATS
     ============================================ */
  .home-stats__inner {
    display: grid;
    grid-template-columns: repeat(10, minmax(0, 1fr));
    gap: 1rem;
    align-items: center;
    padding: 6rem 20px;
  }

  .home-stats__texts { grid-column: 1 / 7; }
  .home-stats__texts h2 { color: var(--color-text-dark); margin-bottom: 1.5rem; }
  .home-stats__texts p { color: rgba(10, 14, 42, 0.6); margin: 0; padding-right: 2rem; }
  .home-stats__texts p + p { margin-top: 0.5rem; }

  .home-stats__stats {
    grid-column: 7 / 11;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .home-stats__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--color-white);
    border-radius: 12px;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.05);
    padding: 1.5rem;
    text-align: center;
    gap: 0.3rem;
  }

  .home-stats__item:nth-child(2) { grid-row: span 2; justify-content: center; }
  .home-stats__number { font-size: 2.8rem; font-weight: 700; color: var(--color-primary); display: inline; }
  .home-stats__suffix { font-size: 1.6rem; font-weight: 600; color: var(--color-primary); }
  .home-stats__number-text { color: rgba(10, 14, 42, 0.7); font-size: 0.85rem; }

  @media (max-width: 900px) {
    .home-stats__texts { grid-column: 1 / 11; padding-right: 0; }
    .home-stats__stats { grid-column: 1 / 11; gap: 1rem; }
    .home-stats__number { font-size: 2rem; }
  }

  /* ============================================
     APPROACH — ROUE (copie exacte Cresco)
     ============================================ */
  .approach {
    overflow: hidden;
    padding-bottom: 128px;
    margin: 8rem 0;
  }

  .approach .content {
    display: grid;
    grid-template-columns: 60% 1fr;
    gap: 1rem;
    align-items: center;
    margin-bottom: 3rem;
  }

  .approach .content.content-title {
    grid-template-columns: 1fr;
    margin: 6rem 0 0;
  }

  .home-approach__title { color: var(--color-white); padding-bottom: 2rem; }

  .approach-wrapper { display: flex; justify-content: center; }

  /* Le conteneur de la roue */
  .approach-wheel {
    width: 650px;
    height: 650px;
    position: relative;
  }

  /* Styles communs aux deux couches de zones */
  .approach-circle-zones {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    width: 650px;
    height: 650px;
    border-radius: 50%;
    overflow: hidden;
    display: grid;
    grid-template-columns: 50% 50%;
    grid-template-rows: 50% 50%;
    transform: rotate(45deg);
  }

  /* Couche arrière : fond coloré qui tourne */
  .approach-circle-active {
    z-index: 1;
    transition: transform 0.5s ease;
  }

  .approach-circle-active .zone {
    background: var(--color-primary-light);
  }

  .approach-circle-active .zone.active {
    background-color: var(--color-white);
  }

  /* Rotations par état */
  .approach-circle-active.assess  { transform: rotate(45deg); }
  .approach-circle-active.protect { transform: rotate(135deg); }
  .approach-circle-active.educate { transform: rotate(225deg); }
  .approach-circle-active.monitor { transform: rotate(315deg); }

  /* Couche avant : zones cliquables transparentes avec texte */
  .approach-circle-front {
    z-index: 2;
    transform: rotate(45deg); /* fixe, ne bouge jamais */
  }

  .approach-circle-front .zone {
    cursor: pointer;
    background: transparent;
    transition: background 0.5s ease;
  }

  .approach-circle-front .zone.active .home-approach__text {
    transform: scale(1);
  }

  .approach-circle-front .zone.active .home-approach__text p {
    color: var(--color-accent);
  }

  .zone-in {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    transform: rotate(-45deg);
  }

  .home-approach__text {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 200px;
    height: 40%;
    transform: scale(0.8);
    transition: transform 0.5s ease;
  }

  .home-approach__text p {
    font-size: 1.4rem;
    font-weight: 600;
    margin: 0;
    color: var(--color-white);
    transition: color 0.3s ease;
  }

  /* Centre */
  .approach-circle-center {
    position: absolute;
    top: 0; bottom: 0; left: 0; right: 0;
    margin: auto;
    width: 40%;
    height: 40%;
    background-color: var(--color-primary);
    border-radius: 50%;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .center-logo {
    font-size: 4rem;
    font-weight: 700;
    color: var(--color-white);
  }

  /* Texte à droite de la roue */
  .steps-text {
    max-width: 500px;
    min-height: 500px;
    position: relative;
    margin: auto;
  }

  .steps-text .step {
    position: absolute;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.5s ease, transform 0.5s ease;
    pointer-events: none;
  }

  .steps-text .step.active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: all;
    position: relative;
  }

  .steps-text h3 { font-size: 2rem; margin-top: 0; margin-bottom: 0.5rem; }
  .step-subtitle { display: block; font-size: 1.1rem; color: rgba(255,255,255,0.7); margin-bottom: 1.5rem; }
  .steps-text p { margin-bottom: 2rem; }

  @media (max-width: 1200px) {
    .approach-wheel,
    .approach-circle-zones { width: 500px; height: 500px; }
  }
  @media (max-width: 900px) {
    .approach .content { grid-template-columns: 1fr; }
    .approach-wheel,
    .approach-circle-zones { width: 400px; height: 400px; margin: 0 auto; }
    .approach { padding-bottom: 2rem; }
  }
  @media (max-width: 600px) {
    .approach-wheel,
    .approach-circle-zones { width: 300px; height: 300px; }
    .home-approach__text { transform: scale(0.65); }
    .home-approach__text p { font-size: 1rem; }
  }

  /* ============================================
     WHY CHOOSE US
     ============================================ */
  .home-why__title { color: var(--color-text-dark); margin: 0; padding-bottom: 2rem; }

  .home-why__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .home-why__item {
    background: radial-gradient(circle, #fff 0%, rgba(235,235,235,0.3) 100%);
    border: 1px solid #e2e2e2;
    border-radius: 0.5rem;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .home-why__item-title { color: var(--color-text-dark); margin: 0.5rem 0 1rem; }
  .home-why__item-text { color: rgba(10,14,42,0.6); margin: 0; }

  @media (max-width: 900px) {
    .home-why__list { grid-template-columns: 1fr; gap: 1rem; }
  }

  /* ============================================
     BLOG
     ============================================ */
  .home-blog__title {
    color: var(--color-text-dark);
    margin: 0;
    padding-bottom: 2rem;
  }

  .home-blog__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: 32px;
    width: 100%;
  }

  .blog-post-item {
    border-radius: 1rem;
    overflow: hidden;
    position: relative;
    display: block;
    max-width: 372px;
    width: 100%;
    color: var(--color-text-dark);
    text-decoration: none;
    outline: 1px solid #efefef;
    transition: color 0.3s ease;
  }

  .blog-post-item:hover {
    color: var(--color-text-dark);
    text-decoration: none;
  }

  .blog-post-item:hover .blog-post-item__title {
    border-top-color: var(--color-primary);
    color: var(--color-primary);
  }

  .blog-post-item:hover .blog-post-item__category::before {
    background: var(--color-primary);
  }

  .blog-post-item__thumbnail-placeholder {
    height: 210px;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 2;
