<script>
  // ============================================
  // ROTATING HERO TEXT
  // ============================================
  const magicTexts = document.querySelectorAll('.magic-text span');
  let currentIndex = 0;

  setInterval(() => {
    magicTexts[currentIndex].classList.remove('current');
    currentIndex = (currentIndex + 1) % magicTexts.length;
    magicTexts[currentIndex].classList.add('current');
  }, 3000);

  // ============================================
  // ANIMATED COUNTERS
  // ============================================
  const counters = document.querySelectorAll('.home-stats__number[data-target]');
  const counterObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const target = parseInt(entry.target.getAttribute('data-target'));
        let count = 0;
        const duration = 2000;
        const increment = target / (duration / 16);
        const updateCount = () => {
          count += increment;
          if (count < target) {
            entry.target.textContent = Math.floor(count);
            requestAnimationFrame(updateCount);
          } else {
            entry.target.textContent = target;
          }
        };
        updateCount();
        counterObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.5 });
  counters.forEach(c => counterObserver.observe(c));

  // ============================================
  // WHEEL INTERACTION (corrigé)
  // ============================================
  // Mapping : index 0=top, 1=right, 2=left, 3=bottom
  const rotations = ['assess', 'protect', 'monitor', 'educate'];
  const frontZones = document.querySelectorAll('.approach-circle-front .zone');
  const activeLayer = document.querySelector('.approach-circle-active');
  const steps = document.querySelectorAll('.steps-text .step');

  frontZones.forEach((zone) => {
    zone.addEventListener('click', () => {
      const index = parseInt(zone.getAttribute('data-index'));

      // 1. Active state sur les zones cliquables (front)
      frontZones.forEach(z => z.classList.remove('active'));
      zone.classList.add('active');

      // 2. Tourner la couche active — zone-1 reste TOUJOURS blanche
      //    C'est la rotation qui la positionne sous la bonne zone
      activeLayer.className = 'approach-circle-zones approach-circle-active ' + rotations[index];

      // 3. Changer le texte à droite
      steps.forEach(s => s.classList.remove('active'));
      steps[index].classList.add('active');
    });
  });
</script>
