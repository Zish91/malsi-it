---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<BaseLayout title="Blog — MALSI IT" description="Articles et conseils en cybersécurité, infrastructure réseau et administration système pour les PME.">
  <div class="circles">
    <div class="circle circle-1"></div>
    <div class="circle circle-2"></div>
  </div>

  <section class="blog-page">
    <div class="container">
      <h1>Blog</h1>
      <p class="blog-page__subtitle">Conseils, retours d'expérience et bonnes pratiques pour sécuriser et gérer votre infrastructure IT.</p>

      <div class="blog-page__grid">
        {posts.map((post) => (
          <a href={`/blog/${post.id}`} class="blog-card">
            <div class="blog-card__thumbnail">
              <span>{post.data.category.toUpperCase()}</span>
            </div>
            <div class="blog-card__content">
              <div class="blog-card__meta">
                <span class="blog-card__category">{post.data.category}</span>
                <span class="blog-card__date">{new Date(post.data.date).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long' })}</span>
              </div>
              <h2 class="blog-card__title">{post.data.title}</h2>
              <p class="blog-card__description">{post.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .blog-page {
    padding: 8rem 0 4rem;
    margin: 0;
  }

  .blog-page h1 { margin-bottom: 1rem; }

  .blog-page__subtitle {
    max-width: 600px;
    margin-bottom: 3rem;
  }

  .blog-page__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  .blog-card {
    border-radius: 1rem;
    overflow: hidden;
    display: block;
    text-decoration: none;
    background: var(--color-white);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .blog-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    color: inherit;
    text-decoration: none;
  }

  .blog-card__thumbnail {
    height: 200px;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .blog-card__thumbnail span {
    color: var(--color-white);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 3px;
    opacity: 0.5;
  }

  .blog-card__content { padding: 1.5rem; }

  .blog-card__meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
  }

  .blog-card__category { color: var(--color-accent); font-weight: 600; }
  .blog-card__date { color: rgba(10, 14, 42, 0.5); }

  .blog-card__title {
    color: var(--color-text-dark);
    font-size: 1.1rem;
    margin: 0 0 0.5rem;
    line-height: 1.4;
  }

  .blog-card__description {
    color: rgba(10, 14, 42, 0.6);
    font-size: 0.9rem;
    margin: 0;
  }

  @media (max-width: 900px) {
    .blog-page__grid { grid-template-columns: 1fr; }
  }
</style>
