  .legal-content p { color: var(--color-text-dark); line-height: 1.8; margin-bottom: 1rem; }
  .legal-content a { color: var(--color-accent); }
  .legal-content a:hover { text-decoration: underline; }
  .legal-content strong { font-weight: 600; }
</style>
