---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact | CIPHER IT" description="Contactez CIPHER IT pour sécuriser et gérer votre infrastructure informatique.">
  <section class="contact">
    <div class="container">
      <h1>Contactez-nous</h1>

      <div class="form-container">
        <form action="https://formsubmit.co/contact@cipher-it.fr" method="POST">
          <input type="hidden" name="_subject" value="Nouveau contact CIPHER IT" />
          <input type="hidden" name="_captcha" value="false" />

          <div class="form-group">
            <div class="form-input-wrapper">
              <svg class="form-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              <input type="text" name="name" id="c-name" placeholder="Nom complet" required />
            </div>
          </div>

          <div class="form-group">
            <div class="form-input-wrapper">
              <svg class="form-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              <input type="email" name="email" id="c-email" placeholder="Email" required />
            </div>
          </div>

          <div class="form-group">
            <div class="form-input-wrapper">
              <svg class="form-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <input type="text" name="phone" id="c-phone" placeholder="Téléphone (facultatif)" />
            </div>
          </div>

          <div class="form-group">
            <div class="form-input-wrapper">
              <svg class="form-icon form-icon--textarea" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              <textarea name="message" id="c-message" placeholder="Votre message" rows="5" required></textarea>
            </div>
          </div>

          <button type="submit" class="btn-primary">Envoyer</button>
        </form>

        <div class="form-sidebar">
          <div>
            <div class="sidebar-card">
              <h2>Besoin d'un diagnostic ?</h2>
              <p>Réservez un appel gratuit de 15 minutes pour discuter de votre infrastructure et identifier vos besoins.</p>
              <a href="https://cal.com/cipher-it/appel-decouverte" target="_blank" class="btn-primary">Réserver un appel</a>
            </div>
            <address class="sidebar-address">
              <h2>Nous écrire</h2>
              <div class="sidebar-links">
                <a href="mailto:contact@cipher-it.fr">contact@cipher-it.fr</a>
                <a href="tel:+33618354388">+33 6 18 35 43 88</a>
              </div>
            </address>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact h1 { margin: 12rem 0 4rem; }

  .form-container {
    display: grid;
    grid-template-columns: calc(50% - 2.5rem) calc(50% - 2.5rem);
    gap: 5rem;
    align-items: flex-start;
  }

  .form-container form { order: -1; }

  .form-group { margin-bottom: 1.5rem; }

  .form-input-wrapper {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    padding: 0.85rem 1rem;
    transition: border-color 0.3s ease, background 0.3s ease;
  }

  .form-input-wrapper:focus-within {
    border-color: var(--color-accent);
    background: rgba(255, 255, 255, 0.08);
  }

  .form-icon {
    color: rgba(255, 255, 255, 0.4);
    flex-shrink: 0;
    margin-top: 2px;
    transition: color 0.3s ease;
  }

  .form-icon--textarea { margin-top: 4px; }

  .form-input-wrapper:focus-within .form-icon {
    color: var(--color-accent);
  }

  .form-input-wrapper input,
  .form-input-wrapper textarea {
    background: none;
    border: none;
    color: var(--color-white);
    font-family: var(--font-family);
    font-size: 0.95rem;
    outline: none;
    width: 100%;
    line-height: 1.5;
  }

  .form-input-wrapper input::placeholder,
  .form-input-wrapper textarea::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  .form-input-wrapper textarea {
    resize: vertical;
    min-height: 120px;
  }

  form button {
    border: none;
    cursor: pointer;
    font-family: var(--font-family);
    font-size: 1rem;
    margin-top: 0.5rem;
  }

  .form-sidebar > div { position: sticky; top: 100px; }

  .sidebar-card {
    background-color: var(--color-white);
    padding: 3rem;
    border-radius: 8px 8px 0 0;
  }

  .sidebar-card * { color: var(--color-primary) !important; }
  .sidebar-card h2 { font-size: 1.6rem; font-weight: 700; margin-top: 0; margin-bottom: 1rem; }
  .sidebar-card p { font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.5rem; }
  .sidebar-card .btn-primary { color: var(--color-white) !important; }

  .sidebar-address {
    background-color: var(--color-gray);
    margin: 0;
    padding: 3rem;
    font-style: normal;
    border-radius: 0 0 8px 8px;
  }

  .sidebar-address * { color: var(--color-primary) !important; }
  .sidebar-address h2 { font-size: 1.6rem; font-weight: 700; margin-top: 0; margin-bottom: 1rem; }

  .sidebar-links { display: flex; flex-direction: column; }
  .sidebar-links a { color: var(--color-accent) !important; font-weight: 600; text-decoration: none; padding: 0.3rem 0; }
  .sidebar-links a:hover { text-decoration: underline; }

  @media (max-width: 900px) {
    .form-container { grid-template-columns: 1fr; gap: 3rem; }
    .contact h1 { margin: 8rem 0 3rem; }
  }
</style>
