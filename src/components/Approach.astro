    display: grid;
    grid-template-columns: 50% 50%;
    grid-template-rows: 50% 50%;
    transform: rotate(45deg);
  }

  .approach-circle-active {
    z-index: 1;
    transition: transform 0.5s ease;
  }

  .approach-circle-active .zone {
    background: var(--color-primary-light);
  }

  .approach-circle-active .zone.active {
    background-color: var(--color-white);
  }

  .approach-circle-active.assess  { transform: rotate(45deg); }
  .approach-circle-active.protect { transform: rotate(135deg); }
  .approach-circle-active.monitor { transform: rotate(315deg); }
  .approach-circle-active.educate { transform: rotate(225deg); }

  .approach-circle-front {
    z-index: 2;
    transform: rotate(45deg);
  }

  .approach-circle-front .zone {
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    background: transparent;
    transition: background 0.5s ease;
  }

  .approach-circle-front .zone.active .home-approach__text {
    transform: scale(1);
  }

  .approach-circle-front .zone.active .home-approach__text p {
    color: var(--color-accent);
  }

  .zone-in {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    transform: rotate(-45deg);
  }

  .home-approach__text {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 200px;
