<section class="home-contact bg-white" id="contact">
  <div class="contact-indicator">
    <svg width="14" height="95" viewBox="0 0 14 95" fill="none">
      <rect class="indicator-line" x="6" y="0" width="2" height="80" fill="#a00032"></rect>
      <circle class="indicator-dot" cx="7" cy="87" r="7" fill="#a00032"></circle>
    </svg>
  </div>

  <h2 data-sal="fade-up" class="home-contact__title">Sécurisons votre entreprise</h2>
  <p class="home-contact__subtitle text--dark">Vous souhaitez évaluer votre infrastructure, obtenir un accompagnement ou simplement poser une question ? Parlons-en.</p>

  <form class="home-contact__form form-dark" action="https://formsubmit.co/contact@malsi-it.fr" method="POST">
    <input type="hidden" name="_subject" value="Nouveau contact MALSI IT" />
    <input type="hidden" name="_captcha" value="false" />

    <div class="ligne">
      <input type="text" name="name" id="name" required />
      <label for="name">Nom complet</label>
    </div>
    <div class="ligne">
      <input type="email" name="email" id="email" required />
      <label for="email">Email</label>
    </div>
    <div class="ligne">
      <input type="text" name="company" id="company" />
      <label for="company">Entreprise</label>
    </div>
    <div class="ligne ligne-textarea">
      <textarea name="message" id="message" required></textarea>
      <label for="message">Message</label>
    </div>
    <div class="ligne">
      <button type="submit" class="btn-primary">Envoyer</button>
    </div>
  </form>
</section>

<style>
  .home-contact { display: flex; flex-direction: column; align-items: center; }
  .home-contact__title { color: var(--color-text-dark); text-align: center; margin: 0; padding-bottom: 1rem; font-weight: 700; }
  .home-contact__subtitle { text-align: center; max-width: 600px; margin: 0 auto 2rem; }

  .home-contact__form {
    max-width: 600px;
    width: 100%;
    margin-top: 2rem;
    padding: 0 20px;
  }

  .home-contact__form button[type="submit"] {
    border: none;
    cursor: pointer;
    font-family: var(--font-family);
    font-size: 1rem;
    width: auto;
  }

  .contact-indicator {
    margin-bottom: 2rem;
    margin-top: -3rem;
  }

  .indicator-line {
    transform-origin: top;
    transform: scaleY(0);
    transition: transform 0.8s ease;
  }

  .indicator-dot {
    transform: scale(0);
    transform-origin: center;
    transition: transform 0.4s ease 0.6s;
  }

  .contact-indicator.animated .indicator-line {
    transform: scaleY(1);
  }

  .contact-indicator.animated .indicator-dot {
    transform: scale(1);
  }

  @media (max-width: 900px) {
    .home-contact { padding-left: 1rem; padding-right: 1rem; }
  }
</style>

<script is:inline>
  document.addEventListener("astro:page-load", () => {
  const indicator = document.querySelector('.contact-indicator');
  const indicatorObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('animated');
        indicatorObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.2 });
  indicatorObserver.observe(indicator);
  });
</script>
