<section class="home-contact bg-white" id="contact">
  <div class="contact-indicator">
    <svg width="14" height="95" viewBox="0 0 14 95" fill="none">
      <rect class="indicator-line" x="6" y="0" width="2" height="80" fill="currentColor" style="color: var(--color-accent);"></rect>
      <circle class="indicator-dot" cx="7" cy="87" r="7" fill="currentColor" style="color: var(--color-accent);"></circle>
    </svg>
  </div>

  <h2 data-sal="fade-up" class="home-contact__title">Sécurisons votre entreprise</h2>
  <p class="home-contact__subtitle text--dark">Vous souhaitez évaluer votre infrastructure, obtenir un accompagnement ou simplement poser une question ? Parlons-en.</p>

  <form class="home-contact__form" action="https://formsubmit.co/contact@cipher-it.fr" method="POST">
    <input type="hidden" name="_subject" value="Nouveau contact CIPHER IT" />
    <input type="hidden" name="_captcha" value="false" />

    <div class="form-group">
      <div class="form-input-wrapper form-input-wrapper--light">
        <svg class="form-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <input type="text" name="name" id="h-name" placeholder="Nom complet" required />
      </div>
    </div>

    <div class="form-group">
      <div class="form-input-wrapper form-input-wrapper--light">
        <svg class="form-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        <input type="email" name="email" id="h-email" placeholder="Email" required />
      </div>
    </div>

    <div class="form-group">
      <div class="form-input-wrapper form-input-wrapper--light">
        <svg class="form-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M12 12h.01"/><path d="M17 12h.01"/><path d="M7 12h.01"/></svg>
        <input type="text" name="company" id="h-company" placeholder="Entreprise (facultatif)" />
      </div>
    </div>

    <div class="form-group">
      <div class="form-input-wrapper form-input-wrapper--light">
        <svg class="form-icon form-icon--textarea" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        <textarea name="message" id="h-message" placeholder="Votre message" rows="5" required></textarea>
      </div>
    </div>

    <button type="submit" class="btn-primary">Envoyer</button>
  </form>
</section>

<style>
  .home-contact { display: flex; flex-direction: column; align-items: center; }
  .home-contact__title { color: var(--color-primary); text-align: center; margin: 0; padding-bottom: 1rem; font-weight: 700; }
  .home-contact__subtitle { text-align: center; max-width: 600px; margin: 0 auto 2rem; }

  .contact-indicator { margin-bottom: 2rem; margin-top: -3rem; }

  .indicator-line {
    transform-origin: top;
    transform: scaleY(0);
    transition: transform 0.8s ease;
  }

  .indicator-dot {
    transform: scale(0);
    transform-origin: center;
    transition: transform 0.4s ease 0.6s;
  }

  .contact-indicator.animated .indicator-line { transform: scaleY(1); }
  .contact-indicator.animated .indicator-dot { transform: scale(1); }

  .home-contact__form {
    max-width: 600px;
    width: 100%;
    margin-top: 1rem;
    padding: 0 20px;
  }

  .form-group { margin-bottom: 1.2rem; }

  .form-input-wrapper--light {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background: rgba(10, 14, 42, 0.03);
    border: 1px solid #e2e2e2;
    border-radius: 10px;
    padding: 0.85rem 1rem;
    transition: border-color 0.3s ease, background 0.3s ease;
  }

  .form-input-wrapper--light:focus-within {
    border-color: var(--color-accent);
    background: rgba(212, 162, 89, 0.03);
  }

  .form-input-wrapper--light .form-icon {
    color: rgba(10, 14, 42, 0.3);
    flex-shrink: 0;
    margin-top: 2px;
    transition: color 0.3s ease;
  }

  .form-icon--textarea { margin-top: 4px; }

  .form-input-wrapper--light:focus-within .form-icon {
    color: var(--color-accent);
  }

  .form-input-wrapper--light input,
  .form-input-wrapper--light textarea {
    background: none;
    border: none;
    color: var(--color-primary);
    font-family: var(--font-family);
    font-size: 0.95rem;
    outline: none;
    width: 100%;
    line-height: 1.5;
  }

  .form-input-wrapper--light input::placeholder,
  .form-input-wrapper--light textarea::placeholder {
    color: rgba(10, 14, 42, 0.35);
  }

  .form-input-wrapper--light textarea {
    resize: vertical;
    min-height: 120px;
  }

  .home-contact__form button {
    border: none;
    cursor: pointer;
    font-family: var(--font-family);
    font-size: 1rem;
    width: auto;
    margin-top: 0.5rem;
  }

  @media (max-width: 900px) {
    .home-contact { padding-left: 1rem; padding-right: 1rem; }
  }
</style>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    const indicator = document.querySelector('.contact-indicator');
    if (!indicator) return;
    const indicatorObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animated');
          indicatorObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });
    indicatorObserver.observe(indicator);
  });
</script>
